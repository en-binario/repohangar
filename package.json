{
  "name": "repohangar",
  "displayName": "RepoHangar - Multi-Repo Git Dashboard",
  "description": "One dashboard for all your Git repositories: fetch, pull and switch branches across repos, open Git Graph, and create GitLab merge requests and GitHub pull requests with saved reviewers, squash and delete-branch defaults.",
  "version": "0.0.0",
  "publisher": "enbinario",
  "author": "Jhon Tapia - enbinario.com",
  "license": "MIT",
  "homepage": "https://repohangar.enbinario.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/en-binario/repohangar"
  },
  "bugs": {
    "url": "https://github.com/en-binario/repohangar/issues"
  },
  "categories": [
    "SCM Providers",
    "Visualization",
    "Other"
  ],
  "keywords": [
    "multi-repo",
    "multirepo",
    "multiple repositories",
    "polyrepo",
    "microservices",
    "git",
    "dashboard",
    "fetch all",
    "pull all",
    "branch",
    "merge request",
    "pull request",
    "gitlab",
    "github",
    "git graph"
  ],
  "engines": {
    "vscode": "^1.93.0",
    "node": ">=20"
  },
  "extensionKind": [
    "workspace"
  ],
  "extensionDependencies": [
    "vscode.git"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "RepoHangar reads Git repositories through the built-in Git extension, which is disabled in Restricted Mode."
    },
    "virtualWorkspaces": false
  },
  "activationEvents": [
    "onStartupFinished",
    "onWebviewPanel:repohangar.dashboard"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "repohangar.open",
        "title": "Open Dashboard",
        "category": "RepoHangar",
        "icon": "$(layout)"
      },
      {
        "command": "repohangar.refresh",
        "title": "Refresh",
        "category": "RepoHangar"
      },
      {
        "command": "repohangar.scm.openDashboard",
        "title": "Open RepoHangar",
        "icon": "$(layout)"
      },
      {
        "command": "repohangar.fetch",
        "title": "Fetch Repository",
        "category": "RepoHangar"
      },
      {
        "command": "repohangar.fetchAll",
        "title": "Fetch All",
        "category": "RepoHangar"
      },
      {
        "command": "repohangar.pullFf",
        "title": "Pull (Fast-Forward Only)",
        "category": "RepoHangar"
      },
      {
        "command": "repohangar.pullAllFf",
        "title": "Pull All (Fast-Forward Only)",
        "category": "RepoHangar"
      },
      {
        "command": "repohangar.switchBranch",
        "title": "Switch Branch in Repositories…",
        "category": "RepoHangar"
      },
      {
        "command": "repohangar.createBranch",
        "title": "Create Branch in Repositories…",
        "category": "RepoHangar"
      },
      {
        "command": "repohangar.scm.fetch",
        "title": "Fetch"
      },
      {
        "command": "repohangar.openInGitGraph",
        "title": "Open in Git Graph",
        "category": "RepoHangar"
      },
      {
        "command": "repohangar.openInSourceControlGraph",
        "title": "Open in Source Control Graph",
        "category": "RepoHangar"
      },
      {
        "command": "repohangar.revealInExplorer",
        "title": "Reveal Repository in Explorer",
        "category": "RepoHangar"
      },
      {
        "command": "repohangar.scm.revealInExplorer",
        "title": "Reveal in Explorer"
      },
      {
        "command": "repohangar.showInSourceControl",
        "title": "Show Repository in Source Control",
        "category": "RepoHangar"
      },
      {
        "command": "repohangar.showInDashboard",
        "title": "Show in RepoHangar",
        "category": "RepoHangar"
      },
      {
        "command": "repohangar.explorer.fetch",
        "title": "Fetch"
      },
      {
        "command": "repohangar.explorer.pullFf",
        "title": "Pull (ff)"
      },
      {
        "command": "repohangar.mr.open",
        "title": "Open Merge Request of Current Branch",
        "category": "RepoHangar"
      },
      {
        "command": "repohangar.mr.copyLink",
        "title": "Copy Merge Request Link",
        "category": "RepoHangar"
      },
      {
        "command": "repohangar.signIn",
        "title": "Sign In to Host…",
        "category": "RepoHangar"
      },
      {
        "command": "repohangar.signOut",
        "title": "Sign Out of Host…",
        "category": "RepoHangar"
      },
      {
        "command": "repohangar.mr.create",
        "title": "Create Merge Request (Defaults)",
        "category": "RepoHangar"
      },
      {
        "command": "repohangar.mr.createEdit",
        "title": "Create Merge Request…",
        "category": "RepoHangar"
      },
      {
        "command": "repohangar.scm.mr.create",
        "title": "Create MR"
      },
      {
        "command": "repohangar.scm.mr.createEdit",
        "title": "Create MR…"
      },
      {
        "command": "repohangar.scm.mr.open",
        "title": "Open MR"
      },
      {
        "command": "repohangar.explorer.mr.create",
        "title": "Create MR"
      },
      {
        "command": "repohangar.explorer.mr.createEdit",
        "title": "Create MR…"
      },
      {
        "command": "repohangar.explorer.mr.open",
        "title": "Open MR"
      }
    ],
    "keybindings": [
      {
        "command": "repohangar.open",
        "key": "ctrl+alt+h",
        "mac": "ctrl+cmd+h"
      },
      {
        "command": "repohangar.openInGitGraph",
        "key": "ctrl+alt+j",
        "mac": "ctrl+cmd+j",
        "when": "repohangar.gitGraph.installed || config.repohangar.gitGraph.whenMissing != 'sourceControlGraph'"
      },
      {
        "command": "repohangar.openInSourceControlGraph",
        "key": "ctrl+alt+j",
        "mac": "ctrl+cmd+j",
        "when": "!repohangar.gitGraph.installed && config.repohangar.gitGraph.whenMissing == 'sourceControlGraph'"
      },
      {
        "command": "repohangar.mr.create",
        "key": "ctrl+alt+m",
        "mac": "ctrl+cmd+m"
      },
      {
        "command": "repohangar.mr.createEdit",
        "key": "ctrl+alt+shift+m",
        "mac": "ctrl+cmd+shift+m"
      }
    ],
    "menus": {
      "scm/title": [
        {
          "command": "repohangar.scm.openDashboard",
          "group": "navigation",
          "when": "scmProvider == git"
        }
      ],
      "commandPalette": [
        {
          "command": "repohangar.scm.openDashboard",
          "when": "false"
        },
        {
          "command": "repohangar.scm.fetch",
          "when": "false"
        },
        {
          "command": "repohangar.openInGitGraph",
          "when": "repohangar.gitGraph.installed || config.repohangar.gitGraph.whenMissing == 'offerInstall'"
        },
        {
          "command": "repohangar.openInSourceControlGraph",
          "when": "!repohangar.gitGraph.installed && config.repohangar.gitGraph.whenMissing == 'sourceControlGraph'"
        },
        {
          "command": "repohangar.scm.revealInExplorer",
          "when": "false"
        },
        {
          "command": "repohangar.showInDashboard",
          "when": "false"
        },
        {
          "command": "repohangar.explorer.fetch",
          "when": "false"
        },
        {
          "command": "repohangar.explorer.pullFf",
          "when": "false"
        },
        {
          "command": "repohangar.scm.mr.create",
          "when": "false"
        },
        {
          "command": "repohangar.scm.mr.createEdit",
          "when": "false"
        },
        {
          "command": "repohangar.scm.mr.open",
          "when": "false"
        },
        {
          "command": "repohangar.explorer.mr.create",
          "when": "false"
        },
        {
          "command": "repohangar.explorer.mr.createEdit",
          "when": "false"
        },
        {
          "command": "repohangar.explorer.mr.open",
          "when": "false"
        }
      ],
      "scm/sourceControl": [
        {
          "command": "repohangar.scm.mr.create",
          "group": "0_repohangar_mr@1",
          "when": "scmProvider == git && scmProviderRootUri in repohangar.hostedRootUris"
        },
        {
          "command": "repohangar.scm.mr.createEdit",
          "group": "0_repohangar_mr@2",
          "when": "scmProvider == git && scmProviderRootUri in repohangar.hostedRootUris"
        },
        {
          "command": "repohangar.scm.mr.open",
          "group": "0_repohangar_mr@3",
          "when": "scmProvider == git && scmProviderRootUri in repohangar.hostedRootUris"
        },
        {
          "command": "repohangar.scm.fetch",
          "group": "repohangar@1",
          "when": "scmProvider == git"
        },
        {
          "command": "repohangar.openInGitGraph",
          "group": "repohangar@2",
          "when": "scmProvider == git && (repohangar.gitGraph.installed || config.repohangar.gitGraph.whenMissing == 'offerInstall')"
        },
        {
          "command": "repohangar.openInSourceControlGraph",
          "group": "repohangar@2",
          "when": "scmProvider == git && !repohangar.gitGraph.installed && config.repohangar.gitGraph.whenMissing == 'sourceControlGraph'"
        },
        {
          "command": "repohangar.scm.revealInExplorer",
          "group": "repohangar@3",
          "when": "scmProvider == git"
        }
      ],
      "explorer/context": [
        {
          "command": "repohangar.openInGitGraph",
          "group": "navigation@100",
          "when": "explorerResourceIsFolder && !listMultiSelection && !repohangar.legacyOpenerInstalled && (repohangar.gitGraph.installed || config.repohangar.gitGraph.whenMissing == 'offerInstall') && (config.repohangar.explorer.contextMenu.showOn == 'allFolders' || resourcePath in repohangar.repositoryRoots)"
        },
        {
          "command": "repohangar.openInSourceControlGraph",
          "group": "navigation@100",
          "when": "explorerResourceIsFolder && !listMultiSelection && !repohangar.legacyOpenerInstalled && !repohangar.gitGraph.installed && config.repohangar.gitGraph.whenMissing == 'sourceControlGraph' && (config.repohangar.explorer.contextMenu.showOn == 'allFolders' || resourcePath in repohangar.repositoryRoots)"
        },
        {
          "submenu": "repohangar.explorer",
          "group": "navigation@101",
          "when": "explorerResourceIsFolder && !listMultiSelection && config.repohangar.explorer.submenu && (config.repohangar.explorer.contextMenu.showOn == 'allFolders' || resourcePath in repohangar.repositoryRoots)"
        }
      ],
      "repohangar.explorer": [
        {
          "command": "repohangar.showInDashboard",
          "group": "1_repohangar@1"
        },
        {
          "command": "repohangar.explorer.fetch",
          "group": "1_repohangar@2"
        },
        {
          "command": "repohangar.explorer.pullFf",
          "group": "1_repohangar@3"
        },
        {
          "command": "repohangar.explorer.mr.create",
          "group": "2_repohangar_mr@1",
          "when": "resourcePath in repohangar.hostedRoots"
        },
        {
          "command": "repohangar.explorer.mr.createEdit",
          "group": "2_repohangar_mr@2",
          "when": "resourcePath in repohangar.hostedRoots"
        },
        {
          "command": "repohangar.explorer.mr.open",
          "group": "2_repohangar_mr@3",
          "when": "resourcePath in repohangar.hostedRoots"
        }
      ]
    },
    "configuration": {
      "title": "RepoHangar",
      "properties": {
        "repohangar.openOnStartup": {
          "type": "string",
          "enum": [
            "never",
            "multiRepo"
          ],
          "enumDescriptions": [
            "Never open the dashboard at startup.",
            "Open the dashboard at startup when the workspace has 3 or more Git repositories."
          ],
          "default": "never",
          "description": "Controls whether the RepoHangar dashboard opens when the window starts.",
          "scope": "window"
        },
        "repohangar.groupBy": {
          "type": "string",
          "enum": [
            "parentFolder",
            "workspaceFolder",
            "custom",
            "none"
          ],
          "enumDescriptions": [
            "Group repositories by the folder that contains them.",
            "Group repositories by the workspace folder that contains them.",
            "Group repositories by the globs in `#repohangar.groups#`.",
            "Show all repositories in one list."
          ],
          "default": "parentFolder",
          "markdownDescription": "How the dashboard groups repositories. The dashboard's **Group** menu can override it for one workspace.",
          "scope": "window"
        },
        "repohangar.groups": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "default": {},
          "markdownDescription": "Custom groups for `#repohangar.groupBy#` `custom`: group name → globs matched against the absolute repository root path (with `/` separators). The first matching group wins; repositories that match none go to `Other`.",
          "scope": "window"
        },
        "repohangar.staleFetchHours": {
          "type": "number",
          "minimum": 0,
          "default": 1,
          "markdownDescription": "Mark the **Fetched** cell with `⚠` when the last fetch is at least this many hours old. `0` turns the marker off.",
          "scope": "window"
        },
        "repohangar.statusBar.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Show the RepoHangar summary in the status bar.",
          "scope": "window"
        },
        "repohangar.hosts": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "enum": [
              "gitlab",
              "github"
            ]
          },
          "default": {},
          "markdownDescription": "Hosting provider of self-hosted Git hosts, for example `{ \"git.acme.com\": \"gitlab\" }`. `github.com`, `gitlab.com` and the host of `#github-enterprise.uri#` are detected without it.",
          "scope": "window"
        },
        "repohangar.providers.refreshMinutes": {
          "type": "integer",
          "default": 3,
          "minimum": 1,
          "maximum": 60,
          "markdownDescription": "Minutes between merge request status refreshes while the window is focused and a pipeline or check is running. No request is sent while the window is unfocused.",
          "scope": "window"
        },
        "repohangar.mr.profiles": {
          "type": "object",
          "default": {
            "default": {}
          },
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "extends": {
                "type": "string",
                "description": "Profile whose values this profile takes for the keys it leaves out."
              },
              "target": {
                "type": "string",
                "description": "Target branch; placeholders allowed, for example {defaultBranch} or release/{latestRelease}."
              },
              "reviewers": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Usernames; @me is you; team:<slug> is a GitHub team."
              },
              "assignees": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "labels": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "squash": {
                "type": "boolean"
              },
              "deleteSourceBranch": {
                "type": "boolean"
              },
              "draft": {
                "type": "boolean"
              },
              "title": {
                "type": "string",
                "description": "Title template: {type}, {ticket}, {branchTitle}, {branch}, {firstCommit}, {repo}, {me}."
              },
              "description": {
                "type": "string",
                "description": "template:default (the repository template, else the built-in one), template:<name>, or a template."
              },
              "pushIfNeeded": {
                "type": "boolean"
              },
              "openAfterCreate": {
                "type": "string",
                "enum": [
                  "notify",
                  "browser",
                  "none"
                ]
              }
            }
          },
          "markdownDescription": "Merge request profiles: named sets of defaults. A profile without `extends` takes the keys it leaves out from `default`, then from the built-in defaults.",
          "scope": "window"
        },
        "repohangar.mr.rules": {
          "type": "array",
          "default": [],
          "items": {
            "type": "object",
            "required": [
              "profile"
            ],
            "properties": {
              "repo": {
                "type": "string",
                "description": "Glob on <host>/<project path>, for example git.acme.com/payments/**"
              },
              "branch": {
                "type": "string",
                "description": "Glob on the branch name, for example hotfix/**"
              },
              "profile": {
                "type": "string"
              },
              "set": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "extends": {
                    "type": "string",
                    "description": "Profile whose values this profile takes for the keys it leaves out."
                  },
                  "target": {
                    "type": "string",
                    "description": "Target branch; placeholders allowed, for example {defaultBranch} or release/{latestRelease}."
                  },
                  "reviewers": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "description": "Usernames; @me is you; team:<slug> is a GitHub team."
                  },
                  "assignees": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "labels": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "squash": {
                    "type": "boolean"
                  },
                  "deleteSourceBranch": {
                    "type": "boolean"
                  },
                  "draft": {
                    "type": "boolean"
                  },
                  "title": {
                    "type": "string",
                    "description": "Title template: {type}, {ticket}, {branchTitle}, {branch}, {firstCommit}, {repo}, {me}."
                  },
                  "description": {
                    "type": "string",
                    "description": "template:default (the repository template, else the built-in one), template:<name>, or a template."
                  },
                  "pushIfNeeded": {
                    "type": "boolean"
                  },
                  "openAfterCreate": {
                    "type": "string",
                    "enum": [
                      "notify",
                      "browser",
                      "none"
                    ]
                  }
                }
              }
            }
          },
          "markdownDescription": "Rules that choose a profile per repository and branch; the first match wins.",
          "scope": "window"
        },
        "repohangar.mr.quickCreate": {
          "type": "string",
          "enum": [
            "direct",
            "confirm"
          ],
          "default": "direct",
          "markdownDescription": "`direct`: `m` and `Ctrl+Alt+M` create the merge request with no dialog. `confirm`: they show one quick input first.",
          "scope": "window"
        },
        "repohangar.mr.ticketPattern": {
          "type": "string",
          "default": "[A-Z][A-Z0-9]+-\\d+",
          "markdownDescription": "Regular expression for the ticket in a branch name (`{ticket}`).",
          "scope": "window"
        },
        "repohangar.mr.typeMap": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "default": {
            "feature": "feat",
            "bugfix": "fix",
            "hotfix": "fix",
            "chore": "chore"
          },
          "markdownDescription": "Branch prefix → `{type}`.",
          "scope": "window"
        },
        "repohangar.gitlab.usePushOptions": {
          "type": "string",
          "enum": [
            "whenNoToken",
            "always",
            "never"
          ],
          "default": "whenNoToken",
          "markdownDescription": "When GitLab merge requests are created with push options during `git push` instead of the API: without a token (`whenNoToken`), `always`, or `never`.",
          "scope": "window"
        },
        "repohangar.concurrency": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32,
          "default": 6,
          "markdownDescription": "How many repositories **Fetch all** and **Pull all (ff)** fetch at the same time.",
          "scope": "window"
        },
        "repohangar.fetchTimeoutSeconds": {
          "type": "integer",
          "minimum": 5,
          "maximum": 600,
          "default": 60,
          "markdownDescription": "Seconds after which RepoHangar stops waiting for the fetch of one repository and records it as failed.",
          "scope": "window"
        },
        "repohangar.dashboard.nameClick": {
          "type": "string",
          "enum": [
            "explorer",
            "gitGraph",
            "sourceControl"
          ],
          "enumDescriptions": [
            "Reveal the repository in the Explorer.",
            "Open the repository in Git Graph, or in the Source Control Graph without Git Graph.",
            "Show the repository in Source Control."
          ],
          "default": "explorer",
          "description": "What a click on a repository name in the dashboard does.",
          "scope": "window"
        },
        "repohangar.gitGraph.whenMissing": {
          "type": "string",
          "enum": [
            "sourceControlGraph",
            "offerInstall",
            "hide"
          ],
          "enumDescriptions": [
            "Open VS Code's Source Control Graph instead; the items read \"Open in Source Control Graph\".",
            "Keep \"Open in Git Graph\" and offer to install Git Graph when it is used.",
            "Hide the graph items; the graph key offers to install Git Graph."
          ],
          "default": "sourceControlGraph",
          "markdownDescription": "What the graph items do while the [Git Graph](https://marketplace.visualstudio.com/items?itemName=mhutchie.git-graph) extension is not installed. RepoHangar never installs it by itself.",
          "scope": "window"
        },
        "repohangar.gitGraph.revealSourceControl": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "After **Open in Git Graph**, also show the Source Control view in the sidebar, as `Ctrl+Shift+G` does. Keyboard focus stays on Git Graph.",
          "scope": "resource"
        },
        "repohangar.gitGraph.syncSourceControlSelection": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "After **Open in Git Graph**, also select the same repository in the Source Control Repositories view. Only applies when `#scm.repositories.selectionMode#` is `single`. Best effort: relies on internal VS Code commands, and failures are only logged to the **RepoHangar** output channel.",
          "scope": "resource"
        },
        "repohangar.explorer.contextMenu.showOn": {
          "type": "string",
          "enum": [
            "repositoryRoots",
            "allFolders"
          ],
          "enumDescriptions": [
            "Show the RepoHangar items only on folders detected as repository roots.",
            "Show the RepoHangar items on every folder; they act on the repository that contains it."
          ],
          "default": "repositoryRoots",
          "description": "Which Explorer folders show \"Open in Git Graph\" and the RepoHangar submenu in their context menu.",
          "scope": "resource"
        },
        "repohangar.explorer.submenu": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Show the **RepoHangar** submenu (**Show in RepoHangar**, **Fetch**, **Pull (ff)**) in the Explorer context menu.",
          "scope": "window"
        },
        "repohangar.explorer.collapseBeforeReveal": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Collapse the Explorer folders before **Reveal in Explorer**, so only the path to the repository is expanded.",
          "scope": "window"
        },
        "repohangar.explorer.outsideWorkspace": {
          "type": "string",
          "enum": [
            "ask",
            "addToWorkspace",
            "newWindow",
            "revealInOS"
          ],
          "enumDescriptions": [
            "Ask each time.",
            "Add the repository folder to the workspace and reveal it.",
            "Open the repository folder in a new window.",
            "Reveal the repository folder in the operating system's file manager."
          ],
          "default": "ask",
          "markdownDescription": "What **Reveal in Explorer** does for a repository outside every workspace folder.",
          "scope": "window"
        },
        "repohangar.repositoryScanDepth": {
          "type": "integer",
          "minimum": 0,
          "default": 3,
          "markdownDescription": "How many folder levels below each workspace folder RepoHangar scans for repository roots for the Explorer context menu, where `0` scans only the workspace folder itself. The scan stops at a repository and never enters `node_modules`.",
          "scope": "resource"
        }
      }
    },
    "submenus": [
      {
        "id": "repohangar.explorer",
        "label": "RepoHangar"
      }
    ]
  },
